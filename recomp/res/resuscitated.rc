// Windows resources for Resuscitated.exe: icon 1 (SDL's window icon too) and version info.
#include <winver.h>
1 ICON "resuscitated.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Trauma Team Resuscitated (unofficial PC port)"
      VALUE "ProductName", "Trauma Team Resuscitated"
      VALUE "FileVersion", "0.1"
      VALUE "ProductVersion", "0.1"
      VALUE "OriginalFilename", "Resuscitated.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
